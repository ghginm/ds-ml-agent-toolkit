{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsml-agent-kit:run-schema:0.1",
  "title": "DS/ML agent task and evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "policy",
    "provenance",
    "execution",
    "results",
    "knowledge"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["0.1", "0.2"]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "goal", "acceptance"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "mode": {"type": "string", "enum": ["tracked", "controlled"]},
        "goal": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "scope": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "non_goals": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "constraints": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "compute": {"type": "string", "pattern": "\\S"},
            "time": {"type": "string", "pattern": "\\S"},
            "cost": {"type": "string", "pattern": "\\S"}
          }
        },
        "evaluation_plan": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "\\S"}
        },
        "expected_outputs": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_ref", "data_classification", "allowed_actions", "approval_gates"],
      "properties": {
        "policy_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "data_classification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted", "unknown"]
        },
        "allowed_actions": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "approval_gates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action", "status"],
            "properties": {
              "action": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "status": {
                "type": "string",
                "enum": ["pending", "approved", "denied", "not_required"]
              },
              "authority": {"type": "string", "pattern": "\\S"},
              "evidence_ref": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "authorization_boundary": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["revision"],
          "properties": {
            "revision": {"type": ["string", "null"], "pattern": "\\S"},
            "working_tree": {"type": "string", "pattern": "\\S"},
            "diff_ref": {"type": ["string", "null"], "pattern": "\\S"}
          }
        },
        "project_map_version": {"type": ["string", "null"], "pattern": "\\S"},
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "\\S"}
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"type": "string", "pattern": "\\S"},
              "ref": {"type": "string", "pattern": "\\S"},
              "classification": {"type": "string", "pattern": "\\S"},
              "version": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "\\S"}
        },
        "seeds": {"type": "array", "items": {"type": ["integer", "string"], "pattern": "\\S"}}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools", "commands", "changed_files"],
      "properties": {
        "tools": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "capability", "status", "exit_code", "evidence_ref"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["command", "operation"]
              },
              "id": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "command": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "capability": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "approval_gate_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "status": {
                "type": "string",
                "enum": ["succeeded", "failed", "blocked", "not_run"]
              },
              "exit_code": {"type": ["integer", "null"]},
              "evidence_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "sanitized_summary": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "changed_files": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "tests", "metrics", "artifacts", "decision"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["not_run", "completed", "partial", "blocked"]
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "status": {
                "type": "string",
                "enum": ["passed", "failed", "skipped", "blocked"]
              },
              "command_ref": {"type": "string", "pattern": "\\S"},
              "evidence_ref": {"type": "string", "pattern": "\\S"},
              "sanitized_summary": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "population", "implementation", "value"],
            "properties": {
              "name": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "population": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "implementation": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "value": {"type": ["string", "number", "null"], "pattern": "\\S"},
              "baseline_value": {"type": ["string", "number", "null"], "pattern": "\\S"},
              "artifact_ref": {"type": "string", "minLength": 1, "pattern": "\\S"}
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
              "classification": {"type": "string", "pattern": "\\S"}
            }
          }
        },
        "experiment_summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["budget", "experiments_run", "stopping_reason", "journal_ref"],
          "properties": {
            "format_version": {"type": "string", "enum": ["0.2"]},
            "budget": {"type": "integer", "minimum": 0},
            "experiments_run": {"type": "integer", "minimum": 0},
            "kept": {"type": "integer", "minimum": 0},
            "discarded": {"type": "integer", "minimum": 0},
            "crashed": {"type": "integer", "minimum": 0},
            "invalid": {"type": "integer", "minimum": 0},
            "stopping_reason": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "selected_revision": {"type": ["string", "null"], "pattern": "\\S"},
            "journal_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "evaluation_ref": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "selected_experiment": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["experiment_id", "candidate_identity"],
              "properties": {
                "experiment_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
                "candidate_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "code_revision": {"type": ["string", "null"], "pattern": "\\S"},
                "config_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                "prediction_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "candidate_learning_events": {
              "type": "array",
              "maxItems": 12,
              "items": {
                "type": "string",
                "enum": [
                  "evaluation_repaired",
                  "point_in_time_violation",
                  "holdout_reuse",
                  "metric_disagreement",
                  "duplicate_config",
                  "duplicate_predictions",
                  "missing_provenance",
                  "untracked_evidence",
                  "selected_experiment_mismatch",
                  "guardrail_failure",
                  "repeated_fallback",
                  "user_rejection",
                  "major_rework"
                ]
              }
            },
            "lifecycle": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "research_decision",
                "evidence_status",
                "independent_validation_status",
                "candidate_branch_status",
                "production_integration_status"
              ],
              "properties": {
                "research_decision": {"type": "string", "enum": ["pending", "accept", "reject"]},
                "evidence_status": {"type": "string", "enum": ["open", "finalized", "invalid"]},
                "independent_validation_status": {"type": "string", "enum": ["not_requested", "pending", "passed", "failed", "unavailable"]},
                "candidate_branch_status": {"type": "string", "enum": ["local", "merged", "unavailable"]},
                "production_integration_status": {"type": "string", "enum": ["not_started", "pending", "completed", "not_applicable"]}
              }
            }
          }
        },
        "decision": {
          "type": "string",
          "enum": ["accept", "reject", "not_applicable", "not_verified"]
        }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_facts", "assumptions", "remaining_uncertainty"],
      "properties": {
        "verified_facts": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "assumptions": {"type": "array", "items": {"type": "string", "pattern": "\\S"}},
        "remaining_uncertainty": {"type": "array", "items": {"type": "string", "pattern": "\\S"}}
      }
    }
  }
}
