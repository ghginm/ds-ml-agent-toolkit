{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsml-agent-kit:learning-schema:0.3",
  "title": "Compact DS/ML agent learning record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_ref", "request", "routing", "signals"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1", "0.2", "0.3", "0.4"]},
    "timestamp": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "toolkit_version": {"type": ["string", "null"], "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "run_ref": {
      "type": "string",
      "pattern": "^\\.agent-system/runs/[A-Za-z0-9][A-Za-z0-9._-]*/run\\.yaml$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "topics", "deliverable"],
      "properties": {
        "kind": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "topics": {
          "type": "array",
          "maxItems": 12,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
        },
        "deliverable": {
          "type": ["string", "null"],
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill", "mode", "corrected"],
      "properties": {
        "skill": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "mode": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "initial_skill": {
          "type": ["string", "null"],
          "pattern": "\\S"
        },
        "initial_mode": {"type": ["string", "null"], "pattern": "\\S"},
        "corrected": {"type": "boolean"}
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "user_outcome", "reason_tags"],
      "properties": {
        "execution": {
          "type": "string",
          "enum": ["not_run", "completed", "partial", "blocked"]
        },
        "user_outcome": {
          "type": "string",
          "enum": ["accepted", "rework_required", "rejected", "unknown"]
        },
        "reason_tags": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"}
        }
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "scope", "importance", "summary"],
        "properties": {
          "type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "scope": {"type": "string", "enum": ["project", "kit"]},
          "importance": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "\\S"
          },
          "suggested_change": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "pattern": "\\S"
          },
          "evidence_ref": {
            "type": ["string", "null"],
            "pattern": "\\S"
          }
        }
      }
    },
    "no_reusable_signal_reason": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 600,
      "pattern": "\\S"
    }
  }
}