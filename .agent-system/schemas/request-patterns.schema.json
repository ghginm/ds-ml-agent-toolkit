{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dsml-agent-kit:request-patterns-schema:0.1",
  "title": "Deterministic recurring request patterns",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_event_count",
    "reviewed_through",
    "minimum_count",
    "patterns"
  ],
  "properties": {
    "schema_version": {"type": "string", "enum": ["0.1"]},
    "source_event_count": {"type": "integer", "minimum": 0},
    "reviewed_through": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "minimum_count": {"type": "integer", "minimum": 1},
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "topics",
          "deliverable",
          "route",
          "count",
          "first_seen",
          "last_seen",
          "trend",
          "friction",
          "recommendation"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^request-[0-9a-f]{12}$"},
          "kind": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "topics": {
            "type": "array",
            "maxItems": 12,
            "items": {"type": "string", "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9_-]*$"}
          },
          "deliverable": {
            "type": ["string", "null"],
            "maxLength": 64,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "route": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}(/[a-z0-9][a-z0-9_-]{0,63})?$"
          },
          "count": {"type": "integer", "minimum": 1},
          "first_seen": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "last_seen": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "trend": {"type": "string", "enum": ["rising", "stable", "falling"]},
          "friction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rework_rate", "routing_corrections", "failures", "reason_tags"],
            "properties": {
              "rework_rate": {"type": "number", "minimum": 0},
              "routing_corrections": {"type": "integer", "minimum": 0},
              "failures": {"type": "integer", "minimum": 0},
              "reason_tags": {
                "type": "object",
                "additionalProperties": {"type": "integer", "minimum": 1}
              }
            }
          },
          "recommendation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target"],
            "properties": {
              "type": {"type": "string", "enum": ["monitor", "improve_existing_skill"]},
              "target": {"type": ["string", "null"], "pattern": "\\S"}
            }
          }
        }
      }
    }
  }
}
